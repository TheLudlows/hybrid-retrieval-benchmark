new file mode 100644
index 0000000..6905400
--- /dev/null
+++ b/hindsight-api-slim/tests/test_rrf_weights.py
@@ -0,0 +1,140 @@
+"""Weighted RRF preserves defaults and composes with caps, boosts and hierarchy."""
+
+from dataclasses import asdict, replace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from hindsight_api._recall_fusion import RecallRRFWeights, validate_rrf_weight
+from hindsight_api.config import HindsightConfig, load_dotenv_for_entrypoint, normalize_config_dict
+from hindsight_api.config_resolver import ConfigResolver
+from hindsight_api.engine.search.fusion import reciprocal_rank_fusion
+from hindsight_api.engine.search.recall_boost import BOOST_LEVELS, boosted_rrf_score, trim_merged_candidates
+from hindsight_api.engine.search.types import RetrievalResult
+from hindsight_api.models import RequestContext
+
+from .test_hierarchical_config import FakeBankConfigBackend, MockTenantExtension
+
+ARMS = ("semantic", "bm25", "graph", "temporal")
+
+
+def result(doc_id: str) -> RetrievalResult:
+    return RetrievalResult(id=doc_id, text=doc_id, fact_type="world")
+
+
+def test_unit_defaults_preserve_original_scores_order_and_ties() -> None:
+    lists = [[result("a"), result("b")], [result("b"), result("a")], [result("c")], []]
+    merged = reciprocal_rank_fusion(lists)
+    explicit = reciprocal_rank_fusion(lists, weights=RecallRRFWeights())
+    assert merged == explicit
+    assert [candidate.id for candidate in merged] == ["a", "b", "c"]
+    assert [candidate.rrf_score for candidate in merged] == [1 / 61 + 1 / 62, 1 / 61 + 1 / 62, 1 / 61]
+    assert merged[0].source_ranks == {"semantic_rank": 1, "bm25_rank": 2}
+
+
+def test_each_arm_contributes_its_own_linear_weight() -> None:
+    weights = RecallRRFWeights(semantic=0.97, bm25=0.03, graph=2.0, temporal=3.0)
+    lists = [[result(arm), result("shared")] for arm in ARMS]
+    merged = reciprocal_rank_fusion(lists, weights=weights)
+    scores = {candidate.id: candidate.rrf_score for candidate in merged}
+    for arm in ARMS:
+        assert scores[arm] == weights.for_source(arm) / 61
+    assert scores["shared"] == sum(weights.for_source(arm) / 62 for arm in ARMS)
+    assert [candidate.id for candidate in merged] == ["shared", "temporal", "graph", "semantic", "bm25"]
+
+
+def test_additional_internal_source_keeps_unit_weight() -> None:
+    merged = reciprocal_rank_fusion([[], [], [], [], [result("extra")]], weights=RecallRRFWeights(semantic=4))
+    assert merged[0].rrf_score == 1 / 61
+    assert merged[0].source_ranks == {"source_4_rank": 1}
+
+
+@pytest.mark.parametrize("arm", ARMS)
+@pytest.mark.parametrize(
+    "invalid", [0, -1, float("nan"), float("inf"), -float("inf"), True, False, "0.5", None, 10**400]
+)
+def test_reject_invalid_weights(arm: str, invalid: object) -> None:
+    with pytest.raises(ValueError, match=f"recall_rrf_{arm}_weight.*finite number greater than 0"):
+        validate_rrf_weight(f"recall_rrf_{arm}_weight", invalid)
+    with pytest.raises(ValueError):
+        replace(RecallRRFWeights(), **{arm: invalid})
+
+
+@pytest.mark.parametrize("arm", ARMS)
+@pytest.mark.parametrize("invalid", ["0", "-0.1", "nan", "inf", "-inf", "true", ""])
+def test_env_rejects_invalid_weights(monkeypatch: pytest.MonkeyPatch, arm: str, invalid: str) -> None:
+    monkeypatch.setenv(f"HINDSIGHT_API_RECALL_RRF_{arm.upper()}_WEIGHT", invalid)
+    with pytest.raises(ValueError):
+        HindsightConfig.from_env()
+
+
+def test_env_fields_are_hierarchical_and_read_contextbase_alias(monkeypatch: pytest.MonkeyPatch) -> None:
+    for arm in ARMS:
+        monkeypatch.delenv(f"HINDSIGHT_API_RECALL_RRF_{arm.upper()}_WEIGHT", raising=False)
+        monkeypatch.setenv(f"CONTEXTBASE_API_RECALL_RRF_{arm.upper()}_WEIGHT", "0.25")
+        # load_dotenv_for_entrypoint writes the alias; ensure pytest restores it.
+        monkeypatch.setenv(f"HINDSIGHT_API_RECALL_RRF_{arm.upper()}_WEIGHT", "1")
+    load_dotenv_for_entrypoint()
+    config = HindsightConfig.from_env()
+    assert asdict(RecallRRFWeights.from_config(config)) == dict.fromkeys(ARMS, 0.25)
+    for arm in ARMS:
+        field = f"recall_rrf_{arm}_weight"
+        assert field in HindsightConfig.get_configurable_fields()
+        assert normalize_config_dict({f"CONTEXTBASE_API_{field.upper()}": 0.5}) == {field: 0.5}
+
+
+@pytest.mark.parametrize("arm", ARMS)
+@pytest.mark.parametrize("level", ["low", "medium", "high"])
+def test_priority_boost_replaces_weighted_contribution(arm: str, level: str) -> None:
+    weights = replace(RecallRRFWeights(), **{arm: 0.03})
+    lists = [[result("same")] for _ in ARMS]
+    candidate = reciprocal_rank_fusion(lists, weights=weights)[0]
+    expected = sum(weights.for_source(other) / 61 for other in ARMS if other != arm)
+    expected += 0.03 / (60 + 1 / BOOST_LEVELS[level].rank_divisor)
+    assert boosted_rrf_score(candidate, {arm: level}, weights=weights) == pytest.approx(expected)
+    assert boosted_rrf_score(candidate, {}, weights=weights) == candidate.rrf_score
+
+
+def test_cap_cannot_undo_a_small_arm_weight_through_priority_boost() -> None:
+    weights = RecallRRFWeights(semantic=0.97, bm25=0.03)
+    candidates = reciprocal_rank_fusion([[result("dense")], [result("lexical")]], weights=weights)
+    original_scores = [candidate.rrf_score for candidate in candidates]
+    trimmed = trim_merged_candidates(candidates, 1, {"bm25": "high"}, weights=weights)
+    assert [candidate.id for candidate in trimmed.kept] == ["dense"]
+    assert trimmed.dropped == 1
+    assert [candidate.rrf_score for candidate in candidates] == original_scores
+
+
+@pytest.mark.asyncio
+async def test_global_tenant_bank_precedence_and_reset_are_isolated() -> None:
+    global_config = replace(HindsightConfig.from_env(), recall_rrf_semantic_weight=0.8)
+    tenant = MockTenantExtension({"recall_rrf_bm25_weight": 0.2})
+    resolver = ConfigResolver(FakeBankConfigBackend(), tenant_extension=tenant)
+    resolver._global_config = global_config
+    resolver._load_bank_config = AsyncMock(
+        side_effect=lambda bank, **kw: {"recall_rrf_semantic_weight": 0.97} if bank == "A" else {}
+    )
+    context = RequestContext(internal=True)
+    a = await resolver.resolve_full_config("A", context)
+    b = await resolver.resolve_full_config("B", context)
+    assert RecallRRFWeights.from_config(a) == RecallRRFWeights(semantic=0.97, bm25=0.2)
+    assert RecallRRFWeights.from_config(b) == RecallRRFWeights(semantic=0.8, bm25=0.2)
+    assert global_config.recall_rrf_semantic_weight == 0.8
+    validated = await resolver.validate_bank_config_updates("A", {"recall_rrf_semantic_weight": None}, context)
+    assert validated.updates == {"recall_rrf_semantic_weight": None}
+    # A null update removes the stored override, revealing its parent's value.
+    resolver._load_bank_config = AsyncMock(return_value={})
+    assert RecallRRFWeights.from_config(
+        await resolver.resolve_full_config("A", context)
+    ) == RecallRRFWeights.from_config(b)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("invalid", [0, -1, float("inf"), float("nan"), True, "0.97"])
+async def test_bad_bank_update_and_tenant_override_fail_before_recall(invalid: object) -> None:
+    resolver = ConfigResolver(FakeBankConfigBackend())
+    with pytest.raises(ValueError):
+        await resolver.validate_bank_config_updates("A", {"recall_rrf_semantic_weight": invalid})
+    resolver.tenant_extension = MockTenantExtension({"recall_rrf_semantic_weight": invalid})
+    with pytest.raises(ValueError):
+        await resolver.resolve_full_config("A", RequestContext(internal=True))
