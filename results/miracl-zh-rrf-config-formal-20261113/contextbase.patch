diff --git a/hindsight-api-slim/hindsight_api/_recall_fusion.py b/hindsight-api-slim/hindsight_api/_recall_fusion.py
new file mode 100644
index 0000000..c59fd0c
--- /dev/null
+++ b/hindsight-api-slim/hindsight_api/_recall_fusion.py
@@ -0,0 +1,54 @@
+"""Validated relative weights shared by configuration and recall fusion."""
+
+import math
+from dataclasses import dataclass, fields
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from .config import HindsightConfig
+
+
+def validate_rrf_weight(name: str, value: object) -> None:
+    """Reject invalid weights at every configuration boundary, including tenants."""
+    if isinstance(value, bool) or not isinstance(value, int | float):
+        raise ValueError(f"Invalid {name}: must be a finite number greater than 0")
+    try:
+        valid = math.isfinite(value) and value > 0
+    except OverflowError:
+        valid = False
+    if not valid:
+        raise ValueError(f"Invalid {name}: must be a finite number greater than 0")
+
+
+@dataclass(frozen=True)
+class RecallRRFWeights:
+    """Relative contributions; unit defaults preserve the original RRF scores.
+
+    Weights need not sum to one. Disable an arm using its enable flag rather
+    than zero weight, so the backend does not perform work that is discarded.
+    """
+
+    semantic: float = 1.0
+    bm25: float = 1.0
+    graph: float = 1.0
+    temporal: float = 1.0
+
+    def __post_init__(self) -> None:
+        for field in fields(self):
+            validate_rrf_weight(f"recall_rrf_{field.name}_weight", getattr(self, field.name))
+
+    @classmethod
+    def from_config(cls, config: "HindsightConfig") -> "RecallRRFWeights":
+        """Read from resolved bank configuration, never the static global proxy."""
+        return cls(
+            semantic=config.recall_rrf_semantic_weight,
+            bm25=config.recall_rrf_bm25_weight,
+            graph=config.recall_rrf_graph_weight,
+            temporal=config.recall_rrf_temporal_weight,
+        )
+
+    def for_source(self, source: str) -> float:
+        """Keep additional internal fusion lists at their historical unit weight."""
+        if source in {"semantic", "bm25", "graph", "temporal"}:
+            return getattr(self, source)
+        return 1.0
