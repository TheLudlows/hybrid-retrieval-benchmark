diff --git a/hindsight-system-tests/tests/test_99_rrf_weights.py b/hindsight-system-tests/tests/test_99_rrf_weights.py
new file mode 100644
index 0000000..be5f52d
--- /dev/null
+++ b/hindsight-system-tests/tests/test_99_rrf_weights.py
@@ -0,0 +1,116 @@
+"""Bank weights reach native fusion, stay isolated, and reset without reindexing."""
+
+from __future__ import annotations
+
+import contextlib
+from typing import Any
+
+import pytest
+from contextbase_client_api.exceptions import ApiException
+
+from hindsight_system_tests.payloads import consolidation, extracted, fact
+
+pytestmark = pytest.mark.asyncio
+
+UNIT = {"semantic": 1.0, "bm25": 1.0, "graph": 1.0, "temporal": 1.0}
+TUNED = {**UNIT, "semantic": 0.97, "bm25": 0.03}
+QUERY = "Where does Alice live?"
+CONTENT = "Alice moved to Berlin in 2021 and plays cello."
+TEXTS = [
+    "Alice moved to Berlin in 2021 | When: 2021 | Involving: Alice",
+    "Alice plays the cello professionally | Involving: Alice",
+]
+
+
+def assert_fusion(trace: dict[str, Any], expected_weights: dict[str, float]) -> None:
+    phase = next(phase for phase in trace["summary"]["phase_metrics"] if phase["phase_name"] == "rrf_merge")
+    assert phase["details"]["fusion"] == "rrf"
+    assert phase["details"]["rrf_weights"] == expected_weights
+    # Assert the score of every fused item, not just the configuration echo.
+    assert len(trace["rrf_merged"]) == 2
+    for item in trace["rrf_merged"]:
+        expected = sum(
+            expected_weights[source.removesuffix("_rank")] / (60 + rank)
+            for source, rank in item["source_ranks"].items()
+        )
+        assert item["rrf_score"] == pytest.approx(expected)
+
+
+async def test_rrf_weights_apply_per_bank_and_null_restores_defaults(client, llm, bank_id, settled) -> None:
+    other_bank = bank_id + "-other"
+    llm.on_step("extract_facts", contains="Berlin").returns(
+        extracted(
+            fact("Alice moved to Berlin in 2021", when="2021", who="Alice", entities=["Alice", "Berlin"]),
+            fact("Alice plays the cello professionally", who="Alice", entities=["Alice", "cello"]),
+        )
+    )
+    llm.on_step("consolidate").returns(consolidation())
+    try:
+        for bank in (bank_id, other_bank):
+            await client.acreate_bank(bank_id=bank)
+            await client.banks.update_bank_config(
+                bank,
+                {
+                    "updates": {
+                        "enable_graph_retrieval": False,
+                        "enable_temporal_retrieval": False,
+                        "enable_reranking": False,
+                    }
+                },
+            )
+            await client.aretain(bank_id=bank, content=CONTENT)
+            await settled(bank)
+        original = await client.arecall(bank_id=bank_id, query=QUERY, trace=True)
+        assert_fusion(original.trace, UNIT)
+        await client.banks.update_bank_config(
+            bank_id,
+            {
+                "updates": {
+                    "recall_rrf_semantic_weight": 0.97,
+                    "recall_rrf_bm25_weight": 0.03,
+                }
+            },
+        )
+        configured = (await client.banks.get_bank_config(bank_id)).config
+        assert configured["recall_rrf_semantic_weight"] == 0.97
+        assert configured["recall_rrf_bm25_weight"] == 0.03
+        assert configured["enable_reranking"] is False
+        tuned = await client.arecall(bank_id=bank_id, query=QUERY, trace=True)
+        assert_fusion(tuned.trace, TUNED)
+        assert [r.text for r in tuned.results] == TEXTS
+        assert [r.scores.final for r in tuned.results] == pytest.approx([1.1, 0.11])
+        assert all(r.scores.reranker is None for r in tuned.results)
+        assert tuned.entities is None
+        assert tuned.chunks is None
+        untouched = await client.arecall(bank_id=other_bank, query=QUERY, trace=True)
+        assert_fusion(untouched.trace, UNIT)
+        assert [r.text for r in untouched.results] == [r.text for r in original.results]
+        await client.banks.update_bank_config(
+            bank_id,
+            {
+                "updates": {
+                    "recall_rrf_semantic_weight": None,
+                    "recall_rrf_bm25_weight": None,
+                }
+            },
+        )
+        restored = await client.arecall(bank_id=bank_id, query=QUERY, trace=True)
+        assert_fusion(restored.trace, UNIT)
+        assert [r.model_dump(exclude={"scores"}) for r in restored.results] == [
+            r.model_dump(exclude={"scores"}) for r in original.results
+        ]
+        for restored_result, original_result in zip(restored.results, original.results, strict=True):
+            assert restored_result.scores.model_dump() == pytest.approx(original_result.scores.model_dump())
+    finally:
+        with contextlib.suppress(ApiException):
+            await client.banks.delete_bank(other_bank)
+
+
+@pytest.mark.parametrize("value", [0, -0.1, True, "0.97"])
+async def test_invalid_bank_weight_does_not_change_saved_config(client, bank_id, value) -> None:
+    await client.acreate_bank(bank_id=bank_id)
+    before = (await client.banks.get_bank_config(bank_id)).config
+    with pytest.raises(ApiException) as error:
+        await client.banks.update_bank_config(bank_id, {"updates": {"recall_rrf_semantic_weight": value}})
+    assert 400 <= error.value.status < 500
+    assert (await client.banks.get_bank_config(bank_id)).config == before
