{
  "onnxruntime": "1.31.1",
  "embedding_intra_op_threads": 3,
  "reranker_intra_op_threads": 3,
  "inter_op_threads": 1,
  "embedding_providers": [
    "CPUExecutionProvider"
  ],
  "reranker_providers": [
    "CPUExecutionProvider"
  ],
  "embedding_batch_window_ms": 10.0,
  "embedding_truncation": {
    "max_length": 512,
    "stride": 0,
    "strategy": "longest_first",
    "direction": "right"
  },
  "reranker_truncation": {
    "max_length": 512,
    "stride": 0,
    "strategy": "longest_first",
    "direction": "right"
  }
}
