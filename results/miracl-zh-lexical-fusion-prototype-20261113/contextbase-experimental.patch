+"""Mechanism tests for the isolated benchmark-only extension."""
+from __future__ import annotations
+
+import os
+import unittest
+from unittest.mock import patch
+
+from hindsight_api import _benchmark_retrieval as experiment
+from hindsight_api.engine.search.fusion import reciprocal_rank_fusion
+from hindsight_api.engine.search.types import RetrievalResult
+from hindsight_api.engine.sql.postgresql import pg_search_should
+
+
+class TestBenchmarkRetrievalExperiment(unittest.TestCase):
+    def setUp(self) -> None:
+        self.environment = patch.dict(os.environ, {
+            "CONTEXTBASE_API_EXPERIMENT_BM25_POLICY": "native",
+            "CONTEXTBASE_API_EXPERIMENT_RRF_VECTOR_WEIGHT": "1",
+            "CONTEXTBASE_API_EXPERIMENT_RRF_KEYWORD_WEIGHT": "1",
+        })
+        self.environment.start()
+        experiment.settings.cache_clear()
+
+    def tearDown(self) -> None:
+        experiment.settings.cache_clear()
+        self.environment.stop()
+
+    def test_disabled_control_keeps_query_sql_and_native_rrf(self) -> None:
+        text = "哥斯达黎加的国歌是什么？"
+        self.assertEqual(experiment.query_text(text), text)
+        self.assertEqual(experiment.stopword_sql(), "")
+        self.assertEqual(experiment.contribution("semantic", 1, 60), 1 / 61)
+        expression = pg_search_should("paradedb", ("text", "text_signals"), "$4", "jieba", 16)
+        self.assertNotIn("<> ALL", expression)
+
+    def test_weighted_fusion_changes_order_with_expected_score(self) -> None:
+        first = RetrievalResult(id="a", text="a", fact_type="world")
+        lexical = RetrievalResult(id="b", text="b", fact_type="world")
+        semantic = [first] + [RetrievalResult(id=f"fill{i}", text="x", fact_type="world") for i in range(18)]
+        semantic.append(lexical)
+        self.assertEqual(reciprocal_rank_fusion([semantic, [lexical]])[0].id, "b")
+        os.environ["CONTEXTBASE_API_EXPERIMENT_RRF_VECTOR_WEIGHT"] = "0.97"
+        os.environ["CONTEXTBASE_API_EXPERIMENT_RRF_KEYWORD_WEIGHT"] = "0.03"
+        experiment.settings.cache_clear()
+        weighted = reciprocal_rank_fusion([semantic, [lexical]])
+        self.assertEqual(weighted[0].id, "a")
+        observed = next(row.rrf_score for row in weighted if row.id == "b")
+        self.assertAlmostEqual(observed, 0.97 / 80 + 0.03 / 61)
+
+    def test_fixed_stopwords_only_change_query_term_filter(self) -> None:
+        os.environ["CONTEXTBASE_API_EXPERIMENT_BM25_POLICY"] = "stop"
+        experiment.settings.cache_clear()
+        self.assertEqual(experiment.query_text("原始问题"), "原始问题")
+        expression = pg_search_should("paradedb", ("text",), "$4", "jieba", 16)
+        self.assertIn("t <> ALL", expression)
+        self.assertIn("'什么'", expression)
+        self.assertIn("$4::text::pdb.jieba", expression)
+
+    def test_script_expansion_preserves_original_and_adds_taiwan_alias(self) -> None:
+        os.environ["CONTEXTBASE_API_EXPERIMENT_BM25_POLICY"] = "expand_stop"
+        experiment.settings.cache_clear()
+        original = "哥斯达黎加的国歌是什么？"
+        expanded = experiment.query_text(original)
+        self.assertTrue(expanded.startswith(original))
+        self.assertIn("哥斯大黎加的國歌是什麼", expanded)
+        self.assertEqual(original, "哥斯达黎加的国歌是什么？")
+        self.assertIn("<> ALL", experiment.stopword_sql())
+
+    def test_invalid_experiment_values_fail_closed(self) -> None:
+        for value in ["0", "-1", "nan", "inf"]:
+            os.environ["CONTEXTBASE_API_EXPERIMENT_RRF_VECTOR_WEIGHT"] = value
+            experiment.settings.cache_clear()
+            with self.assertRaises(ValueError):
+                experiment.settings()
+
+
+if __name__ == "__main__":
+    unittest.main()
