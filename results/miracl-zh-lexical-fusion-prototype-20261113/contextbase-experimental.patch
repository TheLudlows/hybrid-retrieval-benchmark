+"""Benchmark-only retrieval experiment; not a released ContextBase configuration API."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from functools import lru_cache
+import logging
+import math
+import os
+from typing import TYPE_CHECKING, Literal, cast
+
+if TYPE_CHECKING:
+    from opencc import OpenCC
+
+logger = logging.getLogger(__name__)
+Policy = Literal["native", "stop", "expand_stop"]
+# Fixed before this experiment's score collection; not edited per query.
+STOPWORDS = frozenset(
+    "的 了 是 在 有 和 与 哪 谁 什么 哪些 如何 怎么 怎样 哪里 多少 为什么 为何 请问 "
+    "一个 一些 这 那 何时 什么时候 时候 吗 呢".split()
+)
+
+
+@dataclass(frozen=True)
+class ExperimentSettings:
+    policy: Policy
+    vector_weight: float
+    keyword_weight: float
+
+
+@lru_cache(maxsize=1)
+def settings() -> ExperimentSettings:
+    """Settings are immutable for the service lifetime; changing them requires restart."""
+    policy = os.environ.get("CONTEXTBASE_API_EXPERIMENT_BM25_POLICY", "native")
+    if policy not in ("native", "stop", "expand_stop"):
+        raise ValueError(f"Unknown benchmark BM25 policy: {policy}")
+    vector = float(os.environ.get("CONTEXTBASE_API_EXPERIMENT_RRF_VECTOR_WEIGHT", "1"))
+    keyword = float(os.environ.get("CONTEXTBASE_API_EXPERIMENT_RRF_KEYWORD_WEIGHT", "1"))
+    if not all(math.isfinite(value) and value > 0 for value in (vector, keyword)):
+        raise ValueError("Both experimental fusion weights must be finite and positive")
+    result = ExperimentSettings(policy=cast(Policy, policy), vector_weight=vector, keyword_weight=keyword)
+    logger.warning("BENCHMARK-ONLY retrieval source=%s settings=%s", __file__, result)
+    return result
+
+
+def contribution(source: str, rank: int, k: int) -> float:
+    config = settings()
+    weight = config.vector_weight if source == "semantic" else config.keyword_weight if source == "bm25" else 1.0
+    return weight / (k + rank)
+
+
+def stopword_sql() -> str:
+    """Filter only query tokens. Stored documents and their index remain unchanged."""
+    if settings().policy == "native":
+        return ""
+    words = ",".join("'" + word.replace("'", "''") + "'" for word in sorted(STOPWORDS))
+    return f" AND t <> ALL(ARRAY[{words}]::text[])"
+
+
+@dataclass(frozen=True)
+class ScriptConverters:
+    simplified: OpenCC
+    traditional: OpenCC
+    taiwan: OpenCC
+
+
+@lru_cache(maxsize=1)
+def converters() -> ScriptConverters:
+    # Import only for the expansion case, leaving the disabled control independent
+    # of the extra package. Each OpenCC instance is constructed before sharing.
+    from opencc import OpenCC
+
+    return ScriptConverters(OpenCC("t2s"), OpenCC("s2t"), OpenCC("s2twp"))
+
+
+def query_text(text: str) -> str:
+    config = settings()
+    if config.policy != "expand_stop":
+        return text
+    conversion = converters()
+    variants = [text, conversion.simplified.convert(text), conversion.traditional.convert(text),
+                conversion.taiwan.convert(text)]
+    # This function is called only for the BM25 parameter; the original query
+    # continues to feed the embedding model and trace. Spaces delimit variants;
+    # pg_search's existing token filtering removes the whitespace tokens.
+    result = " ".join(dict.fromkeys(variants))
+    logger.info("BM25_EXPERIMENT original=%r expanded=%r", text, result)
+    return result
